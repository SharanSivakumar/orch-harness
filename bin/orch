#!/usr/bin/env bash
# orch — the single entry point to the orchestration framework (v2).
#
# Run it from anywhere inside an instance directory (the folder holding
# orch.yaml), or point it at one with ORCH_INSTANCE=/path/to/instance.
#
# Rig
#   orch init [dir] [--preset <name>] [--name "..."] [--session <tmux>]
#   orch setup questions|apply|defaults|rules|card|check   (docs/SETUP_AGENT_GUIDE.md)
#   orch start [lanes...]        enable lanes (all when none named) and bring the engine up
#   orch status [full] | json    orch dashboard [current|focused|full] [--lane L]   orch monitor
#   orch lint                    orch preflight [--round R | ids | --pending] [--run] [--review]
#   orch day | night | pause [lane] | resume [lane] | stop [lane] | unstop | disable <lanes>
#   orch engine status|stop|log|tick                  orch migrate [--apply] [--archive-complete] [--retire-stale-controls]
# Rows
#   orch assign <id> <executor|default>   orch assignments [all]   orch approve <id>
#   orch dispatch <id>           orch reset <id>          orch adopt <id>     orch prompt <id>... | --all-pending
#   orch rearm <id> "reason" | orch rearm round-start <tag> "reason"   (a row with rearm= on its queue line asks the engine)
#   orch row add <lane> "<queue line>" "why"   add a row (operator; planner / course-loop sessions: the engine validates)
#   orch row diff | orch row sync ["why"]      queue edits outside row add (guard.queue_watch); sync = operator accepts
#   orch done <id> "summary"     orch blocked <id> "reason"     orch escalate <id> "why"   (ROUTE_A)
#                                (done runs the close checks now; the engine re-checks and reviews)
#   orch done <id> "summary" --outcome go|nogo|held|fail|infeasible   a verdict row's answer (needs=go holds on non-go;
#                                infeasible = the remaining plan cannot reach the goal: replan, never re-run)
#   orch verdict <ub-|rv-|pf-session> <VERDICT> "summary"       (unblockers, reviewers, plan reviews)
#   orch closecheck <id>         the stop-line check on its own
# Rounds, decisions, telemetry
#   orch round new|add-lanes|start|status|close|list|archive|score ...
#   orch archive <lanes...> | --complete      orch score [--show]
#   orch gd next|index|digest|show|grep|set-status|check ...
#   orch report [--round R] [--json]
# Guard
#   orch hold <id> <res>[,<res>...] -- <cmd...>   orch commit <id|plan:TAG> -m "msg" -- <paths...>
#   orch lease acquire|release <res> <owner>      orch guard status|start|finish|allowlist|protected|force-release
#   orch longrun [--venv <dir>] <log> -- <cmd...>  orch venvcheck <venv>
# Autonomy (v3)
#   orch service install|uninstall|status         systemd user units: engine, bot, dead-man timer
#   orch steward status|incidents|log|inbox [done <k>]    the Steward lane (incidents, acts, Owner inbox, duties)
#   orch steward close <n> "why"                  the Owner closes an incident by hand (owner-closed; refused in a session)
#   orch park <row> ["why"] | orch unpark <row>   the Owner parks/releases a row (a named carry)
#   orch revert [<k> [--dry-run]]                 the Owner undoes STEWARD_LOG line k (one orch command; else printed)
#   orch executor status                          each executor: normal, or in rate-limit fallback since … -> target
#   orch executor fallback <X> --dry-run          what would move where now (changes nothing); without --dry-run engages by hand
#   orch executor restore <X> ["why"]             clear X's fallback; the pending rows it moved go back to X (the Owner's)
#   orch why <id>                                 plain words: the row's phase, its blocker, its last 5 events
#   orch sw <action> … "why"                      Steward/planner sessions only (engine-validated)
#   orch digest [--send] [--since <epoch>]        the Owner's digest (digest.times sends it on schedule)
#   orch spend run --provider P --est USD [--row id] [--envelope id] -- <cmd…>   a paid command, reserved
#                                                 against the approved caps (over a cap: SPEND_WAIT <id>, exit 75)
#   orch spend status|ledger|caps [approve]|answer <id> A|B   the spend governor (approve/answer: the Owner's)
#   orch phase open <P> [--caps rows=N,rulings=N,days=N,loops=N,replans=N] [--rounds a,b] [--session-loops on|off]
#   orch phase rest|close <P> ["why"] | approve
#   orch phase status                             the phase fence (phases.yaml): open/rest/close/approve are the Owner's
# Other
#   orch bot start|stop|status|test|doctor|poll   orch notify "Title" "Body"   orch attach   orch version
set -u

ORCH_BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ORCH_HOME="$(dirname "$ORCH_BIN")"
LIB="$ORCH_HOME/lib"
GUARD="$LIB/parallel_guard_core.sh"
export ORCH_HOME

usage(){ sed -n '2,/^set -u$/{/^set -u$/!p}' "$0"; }   # the header block, however long

cfg_sh(){ python3 "$LIB/config_parser.py" --sh; }

# --- init ------------------------------------------------------------------
do_init(){
  local dir="" preset="" name="" session=""
  while (( $# )); do
    case $1 in
      --preset)  preset=$2; shift 2 ;;
      --name)    name=$2; shift 2 ;;
      --session) session=$2; shift 2 ;;
      -*) echo "unknown flag $1"; exit 1 ;;
      *) dir=$1; shift ;;
    esac
  done
  dir="${dir:-$PWD}"
  mkdir -p "$dir"/{state,control,leases,prompts,unblock}
  dir="$(cd "$dir" && pwd)"
  name="${name:-$(basename "$(dirname "$dir")")}"
  session="${session:-$(basename "$(dirname "$dir")" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')}"
  local fresh=0
  if [[ -f "$dir/orch.yaml" ]]; then
    echo "orch.yaml already exists in $dir — not overwriting."
  else
    fresh=1
    cat > "$dir/orch.yaml" <<YAML
# orch.yaml — instance configuration. See $ORCH_HOME/README.md
version: "2.0"

project:
  name: "$name"
  root: "../../.."         # cwd for every executor window (project root)
  workspace: ".."          # queue plan paths + reports are relative to this
  tmux_session: "$session"
  reports_dir: "REPORTS"

lanes:
  auto_discover: true      # any queue_<L>.tsv in this folder becomes a lane
  order: []                # optional explicit lane order
  poll_interval: 60
  stall_warning_seconds: 2700

executors:
  default: "opus"
  allowed: [opus, sonnet, haiku, codex, gemini, opencode, manual, mock]
  max_unblock_attempts: 2
  retier_on_max_unblock: "opus"
  unblock_executor: "sonnet"
  auto_unblock: [sonnet, gemini, opencode, codex]
  dead_window_policy: "retier"
  models: {}
  bin: {}
  args: {}                 # extra CLI args per executor, e.g. {opus: ["--effort", "high"]}
  env: {}                  # extra environment per executor
  max_parallel: {}         # per-executor session caps, e.g. {opus: 4}

scheduler:
  mode: "dag"              # dag: declared deps only · serial: a row also waits for every row above it in its lane
  max_parallel: 8          # live sessions of every kind
  min_free_mb: 3072        # no dispatch while MemAvailable is below this

review:
  policy: "all"            # all | junior | none — independent review on a different executor before a row counts

close:
  require_progress: true
  require_commit: false

guard:
  git_repo: ""             # empty -> the workspace
  git_lock: "git-lock"
  auto_phase_isolation: true
  shared_paths:
    - "DECISIONS.md"
  resources:
    - "git-lock"
  compliance_scanners: []

watchdog:
  enabled: false
  telegram_chat_id: ""
  bot_token_env_var: "STATUS_BOT_TOKEN"
  status_bot_allowed_user: ""
  env_file: "~/.config/orch/env"
  push_min_urgency: "normal"   # normal | critical — which engine events reach the phone
  poll_interval: 20
  quiet_hours:
    from: ""
    to: ""
YAML
    echo "wrote $dir/orch.yaml"
  fi
  if [[ ! -f "$dir/queue_A.tsv" ]]; then
    printf '%s\n' \
      '# Lane A ladder. Columns, whitespace-separated:' \
      '#   id  deps  gate  executor  plan_path  [extras…]' \
      '# deps: comma-separated row ids, or - for none.' \
      '# gate: 1 = the engine stops before this row until `orch approve <id>`.' \
      '# plan_path: relative to the workspace, e.g. PHASE_A/setup/PLAN.md' \
      '# extras (optional 6th column on): metadata tokens (res=, reviewer=, timeout=, prio=) or extra allowlist paths' \
      '#   this row may stage, on top of its own phase folder + report pack.' \
      '# The engine rescans this file every pass — appending rows live is SAFE.' \
      '' > "$dir/queue_A.tsv"
    echo "wrote $dir/queue_A.tsv (empty ladder)"
  fi
  # A self-locating entry point INSIDE the instance. Executors run from the
  # project root, where `orch` alone cannot find an orch.yaml (find_instance
  # walks up, never down). This wrapper pins the instance, so a work order can
  # say `<instance>/orch commit <id> -- <paths>` from anywhere.
  cat > "$dir/orch" <<WRAP
#!/usr/bin/env bash
# Auto-generated by \`orch init\`. Pins this instance and delegates to the
# framework CLI. Safe to commit; safe to move together with the instance.
export ORCH_INSTANCE="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
exec "$ORCH_HOME/bin/orch" "\$@"
WRAP
  chmod +x "$dir/orch"
  echo "wrote $dir/orch (self-locating CLI wrapper)"

  if [[ -n $preset ]]; then
    local src="$ORCH_HOME/templates/presets/$preset"
    [[ -d $src ]] || { echo "no preset '$preset' in $ORCH_HOME/templates/presets"; exit 1; }
    local f
    for f in "$src"/_* "$src/README.md"; do
      [[ -f $f && ! -e $dir/prompts/$(basename "$f") ]] && cp "$f" "$dir/prompts/"
    done
    echo "copied preset '$preset' into $dir/prompts/ (edit freely — instance copies win over framework defaults)"
    if [[ $fresh == 1 && -f $src/setup.defaults.yaml ]]; then
      ORCH_INSTANCE="$dir" python3 "$LIB/setup.py" defaults --preset "$preset" || exit 1
    fi
  fi
  ORCH_INSTANCE="$dir" python3 "$LIB/setup.py" rules ${preset:+--preset "$preset"} || exit 1
  ORCH_INSTANCE="$dir" python3 "$LIB/setup.py" card || exit 1
  echo
  echo "instance ready: $dir"
  echo "next:  orch setup questions   (the behaviour switches; answer with orch setup apply --answer id=option)"
  echo "       fill rules/BASE.md      (every TODO(setup))"
  echo "       orch setup check && orch setup card"
  echo "       then plan a round: $ORCH_HOME/docs/PLANNING_AGENT_GUIDE.md"
  echo "(an agent doing this follows $ORCH_HOME/docs/SETUP_AGENT_GUIDE.md)"
}

# --- bot daemon ------------------------------------------------------------
bot(){
  eval "$(cfg_sh)"
  local win="orch-bot"
  case "${1:-status}" in
    start)
      tmux has-session -t "$ORCH_TMUX" 2>/dev/null || tmux new-session -d -s "$ORCH_TMUX" -n control -c "$ORCH_ROOT"
      if tmux list-windows -t "$ORCH_TMUX" -F '#{window_name} #{pane_dead}' | grep -q "^$win 0$"; then
        echo "status bot already running (tmux window '$win')"
      else
        tmux kill-window -t "$ORCH_TMUX:$win" 2>/dev/null || true
        tmux new-window -d -t "$ORCH_TMUX" -n "$win" -c "$ORCH_ROOT" \
          "ORCH_INSTANCE='$ORCH_INSTANCE' python3 '$LIB/telegram_bot.py' daemon"
        echo "status bot started (tmux window '$win' in session $ORCH_TMUX)"
      fi ;;
    stop)   tmux kill-window -t "$ORCH_TMUX:$win" 2>/dev/null && echo "status bot stopped" || echo "status bot was not running" ;;
    status) tmux list-windows -t "$ORCH_TMUX" -F '#{window_name} #{pane_dead}' 2>/dev/null | grep -q "^$win 0$" \
              && echo "status bot RUNNING (tmux $ORCH_TMUX:$win)" || echo "status bot not running" ;;
    poll)   python3 "$LIB/telegram_bot.py" poll ;;
    test)   python3 "$LIB/telegram_bot.py" test ;;
    doctor) python3 "$LIB/telegram_bot.py" doctor ;;
    *) echo "usage: orch bot start|stop|status|poll|test|doctor"; exit 1 ;;
  esac
}

cmd="${1:-}"; shift || true
CTL="$LIB/orchctl.py"
case "$cmd" in
  init)        do_init "$@" ;;
  setup)       exec python3 "$LIB/setup.py" "$@" ;;
  status)      python3 "$LIB/state_resolver.py" $( [[ "${1:-}" == full ]] && echo --full ) ;;
  json)        python3 "$LIB/state_resolver.py" --json ;;
  lint)        python3 "$LIB/lint.py" ;;
  preflight)   exec python3 "$LIB/preflight.py" "$@" ;;
  report)      exec python3 "$LIB/report.py" "$@" ;;
  round)       exec python3 "$LIB/rounds.py" "$@" ;;
  archive)     exec python3 "$LIB/rounds.py" archive "$@" ;;
  score)       exec python3 "$LIB/rounds.py" score "$@" ;;
  gd)          exec python3 "$LIB/decisions.py" "$@" ;;
  dashboard)   python3 "$LIB/dashboard_tui.py" "$@" ;;
  monitor)     python3 "$LIB/monitor_tui.py" "$@" ;;
  bot)         bot "$@" ;;
  notify)      python3 "$LIB/telegram_bot.py" push --title "${1:-test}" --body "${2:-}" --force ;;
  closecheck)  exec python3 "$LIB/close_check.py" "${1:?usage: orch closecheck <id>}" ;;
  service)     exec python3 "$LIB/service.py" "$@" ;;
  steward)     exec python3 "$LIB/steward.py" "$@" ;;
  inbox)       exec python3 "$LIB/steward.py" inbox "$@" ;;
  park|unpark) exec python3 "$LIB/steward.py" "$cmd" "$@" ;;
  sw)          exec python3 "$LIB/steward.py" sw "$@" ;;
  executor)    exec python3 "$LIB/fallback.py" "$@" ;;
  row)         exec python3 "$LIB/rowadd.py" "$@" ;;
  revert)      exec python3 "$LIB/revert.py" "$@" ;;
  why)         exec python3 "$LIB/why.py" "$@" ;;
  digest)      exec python3 "$LIB/digest.py" "$@" ;;
  spend)       exec python3 "$LIB/spend.py" "$@" ;;
  phase)       exec python3 "$LIB/phases.py" "$@" ;;
  longrun)     exec "$LIB/longrun.sh" longrun "$@" ;;
  venvcheck)   exec "$LIB/longrun.sh" venvcheck "$@" ;;
  attach)      eval "$(cfg_sh)"; exec tmux ${ORCH_TMUX_SOCKET:+-L "$ORCH_TMUX_SOCKET"} attach -t "$ORCH_TMUX" ;;
  # guard surfaces
  hold)        exec "$GUARD" hold "$@" ;;
  commit)      exec "$GUARD" commit "$@" ;;
  guard)       exec "$GUARD" "$@" ;;
  # engine surfaces
  start|night|day|pause|resume|stop|unstop|disable|assign|assignments|approve|dispatch|done|blocked|escalate|verdict|reset|rearm|adopt|prompt|lease|engine|migrate)
               exec python3 "$CTL" "$cmd" "$@" ;;
  version)     echo "orch 2.0.0 — $ORCH_HOME @ $(git -C "$ORCH_HOME" rev-parse --short HEAD 2>/dev/null)$( [[ -n $(git -C "$ORCH_HOME" status --porcelain 2>/dev/null | grep -v __pycache__) ]] && echo ' (dirty)')" ;;
  ""|help|-h|--help) usage ;;
  *)           echo "unknown command '$cmd'"; echo; usage; exit 1 ;;
esac
